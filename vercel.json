{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/messages", "destination": "/messages.html" }
  ],
  "headers": [
    {
      "source": "/wedding.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"almonzer-eman-wedding.ics\"" }
      ]
    }
  ]
}
